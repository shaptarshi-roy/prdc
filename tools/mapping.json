{
  "_comment": [
    "Mapping from CSV column name to (table, codebook_ref, is_multi, type_hint, notes).",
    "",
    "codebook_ref formats:",
    "  'adult:VarName'        → look up in MDS_Adult_codebook.json at top level",
    "  'pt:/Module/Section/.../Item'   → walk MDS_PT_codebook.json by path",
    "  null                   → no codebook ref; must provide type_hint",
    "",
    "type_hint (only used when codebook_ref is null or codebook is numeric/free-form):",
    "  'bool', 'smallint', 'integer', 'numeric(4,1)', 'text', 'date',",
    "  'vas_100', 'vas_10', 'plz_de', 'plausible_year',",
    "  'uuid', 'iso3166_3', 'iso639_3'",
    "",
    "is_multi: true → emit TEXT[] / ENUM[]; false → scalar",
    "",
    "If codebook_ref is set AND type_hint is null AND Antwortoptionen is a list,",
    "generator emits a dedicated ENUM type named <column>_t."
  ],
  "_tables": {
    "facilities": "primary key: facility_id",
    "therapists": "primary key: therapist_id, FK: facility_id",
    "patients_adult": "primary key: patient_id",
    "treatments": "primary key: treatment_id, FKs: patient_id, therapist_id, facility_id",
    "assessments": "primary key: assessment_id (generated); (treatment_id, timepoint) unique",
    "process_ratings": "primary key: process_id (generated); (treatment_id, timepoint) unique"
  },
